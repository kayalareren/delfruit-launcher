{
  "name": "delfruit-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Delicious Fruit fangame browser, installer and launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "directories": { "output": "outputs" },
    "appId": "com.delfruit.launcher",
    "productName": "DelFruit Launcher",
    "asar": true,
    "beforePack": "src/native/build-controls.js",
    "files": ["src/**/*", "package.json"],
    "win": {
      "extraResources": [{ "from": "work/native/GameControls.exe", "to": "GameControls.exe" }],
      "icon": "src/renderer/assets/fruit-icon.png",
      "target": ["portable", "nsis"]
    },
    "portable": { "artifactName": "${productName}-${version}-Portable-${arch}.${ext}" },
    "nsis": {
      "include": "installer.nsh",
      "installerSidebar": "build/installerSidebarSelected.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DelFruit-Launcher-v1.0.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
